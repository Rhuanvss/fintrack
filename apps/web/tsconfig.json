{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": ["src/**/*", "next-env.d.ts", ".next/types/**/*"],
  "exclude": ["node_modules", "dist", ".next"]
}
