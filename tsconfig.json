{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["apps/web/src/*"],
      "@fintrack/shared": ["packages/shared/src"]
    },
    "jsx": "preserve",
    "noEmit": true
  },
  "include": ["apps/**/src/**/*", "packages/**/src/**/*"],
  "exclude": ["node_modules", "dist", ".next", ".turbo"]
}
